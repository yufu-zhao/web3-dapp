{
  "name": "chainforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @chainforge/user --filter @chainforge/admin --filter @chainforge/installer --filter @chainforge/api --filter @chainforge/installer-service run dev",
    "dev:user": "pnpm --filter @chainforge/user dev",
    "dev:admin": "pnpm --filter @chainforge/admin dev",
    "dev:installer-ui": "pnpm --filter @chainforge/installer dev",
    "dev:api": "pnpm --filter @chainforge/api dev",
    "dev:installer-service": "pnpm --filter @chainforge/installer-service dev",
    "dev:indexer": "pnpm --filter @chainforge/api dev:indexer",
    "build": "pnpm clean && pnpm --recursive --if-present run build",
    "build:user": "pnpm --filter @chainforge/user build",
    "build:admin": "pnpm --filter @chainforge/admin build",
    "build:installer-ui": "pnpm --filter @chainforge/installer build",
    "build:api": "pnpm --filter @chainforge/api build",
    "build:installer-service": "pnpm --filter @chainforge/installer-service build",
    "build:shared-types": "pnpm --filter @chainforge/shared-types build",
    "build:public-chain": "pnpm --filter @chainforge/public-chain build",
    "start:api": "node dist/services/api/main.js",
    "start:installer": "node dist/services/installer/main.js",
    "start:indexer": "node dist/services/api/indexer.js",
    "typecheck": "pnpm --recursive --parallel --if-present run typecheck",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm lint:check:apps && pnpm lint:check:shared",
    "lint:check:apps": "pnpm --filter @chainforge/admin --filter @chainforge/installer --filter @chainforge/user --parallel run lint:check",
    "lint:check:shared": "oxfmt --config oxfmt.config.ts --check \"services/**/*.{ts,json,vue}\" \"packages/**/*.{ts,json,vue}\" \"scripts/**/*.{mjs,ts}\" \"docs/**/*.md\" package.json pnpm-workspace.yaml tsconfig.base.json oxfmt.config.ts oxlint.config.ts AGENTS.md README.md && oxlint --config oxlint.config.ts services packages scripts",
    "lint:fix": "pnpm lint:fix:apps && pnpm lint:fix:shared",
    "lint:fix:apps": "pnpm --filter @chainforge/admin --filter @chainforge/installer --filter @chainforge/user --parallel run lint",
    "lint:fix:shared": "oxfmt --config oxfmt.config.ts \"services/**/*.{ts,json,vue}\" \"packages/**/*.{ts,json,vue}\" \"scripts/**/*.{mjs,ts}\" \"docs/**/*.md\" package.json pnpm-workspace.yaml tsconfig.base.json oxfmt.config.ts oxlint.config.ts AGENTS.md README.md && oxlint --config oxlint.config.ts --fix services packages scripts",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/openai-compatible": "^3.0.87",
    "@fastify/multipart": "^9.4.0",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-fastify": "^12.3.3",
    "ai": "^7.0.165",
    "ethers": "^6.17.0",
    "fastify": "^5.12.8",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@types/node": "^22.15.30",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "pnpm@11.6.0"
}
