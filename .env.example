# 复制为 .env 并按需修改；加载方式见 README.md。

# PostgreSQL 连接串。首次安装时可由安装器配置；服务重启后需加载此变量。
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/chainforge

# 可选：尚未在管理后台保存 RPC 配置时，临时覆盖 rpcs.json 默认只读节点。
CHAIN_RPC_URL=

# 大模型 API 密钥的 AES-256-GCM 主密钥；生成命令：openssl rand -base64 32。
# 必须在所有 API 实例间保持一致，并安全备份；更换后无法解密数据库中的既有密钥。
AI_CONFIG_ENCRYPTION_KEY=

# 是否在非 BSC 主网启用 MockUSDT 测试币领取入口。
ENABLE_MOCKUSDT=false

# 管理后台上传的轮播和公告媒体文件目录；相对路径以 API 工作目录为基准。
CONTENT_ASSET_DIR=data/content-assets

# Reown AppKit Project ID（公开标识，浏览器连接钱包必需；从 Reown Dashboard 获取）。
WALLETCONNECT_PROJECT_ID=

# 前端开发服务器端口。
USER_PORT=5675
ADMIN_PORT=5676
INSTALLER_UI_PORT=5677

# 业务 API 监听地址和端口。
API_HOST=127.0.0.1
API_PORT=3610

# 安装器服务监听地址和端口。
INSTALLER_SERVICE_HOST=127.0.0.1
INSTALLER_SERVICE_PORT=3611

# 允许访问两个 HTTP 服务的浏览器来源，多个来源用逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5675,http://127.0.0.1:5676,http://127.0.0.1:5677,http://localhost:5675,http://localhost:5676,http://localhost:5677
