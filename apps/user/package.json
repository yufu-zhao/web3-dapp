{
  "name": "@chainforge/user",
  "version": "0.0.1",
  "private": true,
  "description": "chainforge user",
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-app-vite",
    "quasar-cli",
    "vite",
    "vue",
    "vuejs"
  ],
  "author": "chainforge",
  "type": "module",
  "scripts": {
    "lint": "oxfmt --config ../../oxfmt.config.ts && oxlint --config ../../oxlint.config.ts --fix",
