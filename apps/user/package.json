    "@quasar/extras": "^2.1.0",
    "ethers": "^6.17.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.3",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.0.0",
    "@quasar/app-vite": "^3.10.4",
    "@types/node": "^22.19.11",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.27",
    "oxfmt": "^0.x",
    "oxlint": "^1.x",
    "oxlint-tsgolint": "^7.0.2001",
