{
  "schemaVersion": 1,
  "releaseVersion": "0.1.0",
  "nodes": [
    {
      "id": "ProjectToken",
      "contractName": "ProjectToken",
      "kind": "transaction",
      "dependsOn": [],
      "constructorArgs": [
        {
          "name": "tokenName_",
          "source": "formInput",
          "key": "installation.tokenName"
        },
        {
          "name": "tokenSymbol_",
          "source": "formInput",
          "key": "installation.tokenSymbol"
        },
        {
          "name": "paymentToken",
          "source": "formInput",
          "key": "externalAddresses.paymentToken",
          "verificationGetter": "paymentToken"
        },
        {
          "name": "factory",
          "source": "formInput",
          "key": "externalAddresses.factory",
          "verificationGetter": "dexFactory"
        },
        {
          "name": "ecoWallet",
          "source": "adminInput",
          "key": "ecosystemWallet",
          "verificationGetter": "ecosystemWallet"
        },
        {
          "name": "operator",
          "source": "adminInput",
          "key": "operator"
        },
        {
          "name": "launch",
          "source": "adminInput",
          "key": "launch"
        },
        {
          "name": "batchRegistrar",
          "source": "adminInput",
          "key": "batchRegistrar"
        },
        {
          "name": "pauser",
          "source": "adminInput",
          "key": "pauser"
        }
      ],
      "roleChecks": [
        {
          "roleGetter": "OPERATOR_ROLE",
          "accountSource": {
            "source": "adminInput",
            "key": "operator"
          }
        },
        {
          "roleGetter": "LAUNCH_ROLE",
          "accountSource": {
            "source": "adminInput",
            "key": "launch"
          }
        },
        {
          "roleGetter": "BATCH_REGISTRAR_ROLE",
          "accountSource": {
            "source": "adminInput",
            "key": "batchRegistrar"
          }
        },
        {
          "roleGetter": "PAUSER_ROLE",
          "accountSource": {
            "source": "adminInput",
            "key": "pauser"
          }
        },
        {
          "roleGetter": "DEFAULT_ADMIN_ROLE",
          "accountSource": {
            "source": "deployer"
          }
        }
      ],
      "sourcePath": "sources/v2/ProjectToken.sol"
    },
    {
      "id": "FairSaleV2",
      "contractName": "FairSaleV2",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        },
        {
          "name": "proceeds_",
          "source": "adminInput",
          "key": "proceedsWallet",
          "verificationGetter": "proceedsWallet"
        }
      ],
      "sourcePath": "sources/v2/FairSaleV2.sol"
    },
    {
      "id": "TokenRewardVault",
      "contractName": "TokenRewardVault",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        }
      ],
      "sourcePath": "sources/v2/TokenRewardVault.sol"
    },
    {
      "id": "TokenStaking",
      "contractName": "TokenStaking",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken",
        "FairSaleV2",
        "TokenRewardVault"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        },
        {
          "name": "sale_",
          "source": "deployedAddress",
          "nodeId": "FairSaleV2",
          "verificationGetter": "sale"
        },
        {
          "name": "vault_",
          "source": "deployedAddress",
          "nodeId": "TokenRewardVault",
          "verificationGetter": "rewardVault"
        },
        {
          "name": "feeWallet_",
          "source": "adminInput",
          "key": "feeWallet",
          "verificationGetter": "feeWallet"
        }
      ],
      "sourcePath": "sources/v2/TokenStaking.sol"
    },
    {
      "id": "TokenTimeLock",
      "contractName": "TokenTimeLock",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        }
      ],
      "sourcePath": "sources/v2/TokenTimeLock.sol"
    },
    {
      "id": "TokenPriceOracle",
      "contractName": "TokenPriceOracle",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        },
        {
          "name": "samplePeriod",
          "source": "formInput",
          "key": "oracle.samplePeriodSeconds",
          "verificationGetter": "period"
        },
        {
          "name": "minReserve",
          "source": "formInput",
          "key": "oracle.minimumPaymentReserve",
          "verificationGetter": "minimumPaymentReserve"
        }
      ],
      "sourcePath": "sources/v2/TokenPriceOracle.sol"
    },
    {
      "id": "TokenLimitOrders",
      "contractName": "TokenLimitOrders",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        },
        {
          "name": "router_",
          "source": "formInput",
          "key": "externalAddresses.router",
          "verificationGetter": "router"
        }
      ],
      "sourcePath": "sources/trading/TokenLimitOrders.sol"
    },
    {
      "id": "StrategicLiquidityVaultV2",
      "contractName": "StrategicLiquidityVaultV2",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "token_",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "token"
        },
        {
          "name": "router_",
          "source": "formInput",
          "key": "externalAddresses.router",
          "verificationGetter": "router"
        },
        {
          "name": "fundingWallet_",
          "source": "adminInput",
          "key": "fundingWallet",
          "verificationGetter": "fundingWallet"
        }
      ],
      "sourcePath": "sources/v2/StrategicLiquidityVaultV2.sol"
    },
    {
      "id": "PermanentLPVaultV2",
      "contractName": "PermanentLPVaultV2",
      "kind": "nested",
      "parentNodeId": "StrategicLiquidityVaultV2",
      "addressResolver": {
        "type": "getter",
        "function": "lpVault"
      },
      "dependsOn": [
        "StrategicLiquidityVaultV2"
      ],
      "constructorArgs": [],
      "sourcePath": "sources/v2/StrategicLiquidityVaultV2.sol"
    },
    {
      "id": "PrizeClaimVault",
      "contractName": "PrizeClaimVault",
      "kind": "transaction",
      "dependsOn": [
        "ProjectToken"
      ],
      "constructorArgs": [
        {
          "name": "tokenAddress",
          "source": "formInput",
          "key": "externalAddresses.paymentToken",
          "verificationGetter": "token"
        },
        {
          "name": "roleControllerAddress",
          "source": "deployedAddress",
          "nodeId": "ProjectToken",
          "verificationGetter": "roleController"
        },
        {
          "name": "recoveryWalletAddress",
          "source": "adminInput",
          "key": "recoveryWallet",
          "verificationGetter": "recoveryWallet"
        }
      ],
      "sourcePath": "sources/extensions/PrizeClaimVault.sol"
    }
  ],
  "postDeploymentActions": [
    {
      "id": "configureModules",
      "kind": "contractCall",
      "title": "登记预售合约和流动性金库",
      "description": "将 3,000,000 TOKEN 分配给预售合约，将 18,000,000 TOKEN 分配给流动性金库。",
      "targetNodeId": "ProjectToken",
      "functionName": "configureModules",
      "arguments": [
        {
          "source": "deployedAddress",
          "nodeId": "FairSaleV2"
        },
        {
          "source": "deployedAddress",
          "nodeId": "StrategicLiquidityVaultV2"
        }
      ],
      "dependsOn": [
        "FairSaleV2",
        "StrategicLiquidityVaultV2"
      ],
      "effects": [
        {
          "recipientNodeId": "FairSaleV2",
          "amount": "3000000",
          "symbol": "TOKEN"
        },
        {
          "recipientNodeId": "StrategicLiquidityVaultV2",
          "amount": "18000000",
          "symbol": "TOKEN"
        }
      ]
    },
    {
      "id": "ensureTradingPair",
      "kind": "getOrCreatePair",
      "title": "检查或创建 TOKEN 交易对",
      "description": "先读取 Factory.getPair；已存在且 Token/Factory 均匹配时复用，缺失时才请求钱包创建。",
      "dependsOn": [
        "ProjectToken",
        "configureModules"
      ],
      "factoryAbiPath": "external-abi/PancakeV2Factory.json",
      "pairAbiPath": "external-abi/PancakeV2Pair.json",
      "factory": {
        "source": "formInput",
        "key": "externalAddresses.factory"
      },
      "tokenA": {
        "source": "deployedAddress",
        "nodeId": "ProjectToken"
      },
      "tokenB": {
        "source": "formInput",
        "key": "externalAddresses.paymentToken"
      },
      "factoryAbiHash": "0x367f4630da5d8c784db89611c01344eb42ee9e83d58cb36c15d31d19814b14ef",
      "pairAbiHash": "0x165529a6e7d703908733e70be335e5d2673d686a3555d0b77e44f2331c648966",
      "paymentTokenAbiPath": "external-abi/PaymentToken.json",
      "paymentTokenAbiHash": "0x38455a3b068d95ae30bfa89f5c161771acda5fac616834e5e9a02619ff8bd2e4"
    },
    {
      "id": "configurePair",
      "kind": "contractCall",
      "title": "将交易对登记到 TOKEN 合约",
      "description": "把已核验的 TOKEN/支付 Token 交易对写入主合约。",
      "targetNodeId": "ProjectToken",
      "functionName": "configurePair",
      "arguments": [
        {
          "source": "actionResult",
          "actionId": "ensureTradingPair"
        }
      ],
      "dependsOn": [
        "configureModules",
        "ensureTradingPair"
      ]
    },
    {
      "id": "configureOraclePair",
      "kind": "contractCall",
      "title": "为预言机绑定已登记交易对",
      "description": "交易对在主合约登记后，由部署超管将同一交易对绑定到预言机。",
      "targetNodeId": "TokenPriceOracle",
      "functionName": "configurePair",
      "arguments": [
        {
          "source": "actionResult",
          "actionId": "ensureTradingPair"
        }
      ],
      "dependsOn": [
        "configurePair",
        "ensureTradingPair",
        "TokenPriceOracle"
      ]
    },
    {
      "id": "configureOracle",
      "kind": "contractCall",
      "title": "将价格预言机登记到 TOKEN 合约",
      "description": "绑定本版本部署的价格预言机，并由合约重置其启动采样状态。",
      "targetNodeId": "ProjectToken",
      "functionName": "configureOracle",
      "arguments": [
        {
          "source": "deployedAddress",
          "nodeId": "TokenPriceOracle"
        }
      ],
      "dependsOn": [
        "configureOraclePair",
        "configurePair",
        "TokenPriceOracle"
      ]
    },
    {
      "id": "bindStaking",
      "kind": "contractCall",
      "title": "将质押合约绑定到奖励金库",
      "description": "奖励金库只允许已绑定的质押合约调用奖励支付。",
      "targetNodeId": "TokenRewardVault",
      "functionName": "bindStaking",
      "arguments": [
        {
          "source": "deployedAddress",
          "nodeId": "TokenStaking"
        }
      ],
      "dependsOn": [
        "TokenRewardVault",
        "TokenStaking"
      ]
    }
  ],
  "verificationRules": [
    {
      "id": "sale-module",
      "targetNodeId": "ProjectToken",
      "getter": "sale",
      "expected": {
        "source": "deployedAddress",
        "nodeId": "FairSaleV2"
      }
    },
    {
      "id": "liquidity-module",
      "targetNodeId": "ProjectToken",
      "getter": "liquidityVault",
      "expected": {
        "source": "deployedAddress",
        "nodeId": "StrategicLiquidityVaultV2"
      }
    },
    {
      "id": "price-oracle-module",
      "targetNodeId": "ProjectToken",
      "getter": "priceOracle",
      "expected": {
        "source": "deployedAddress",
        "nodeId": "TokenPriceOracle"
      }
    },
    {
      "id": "staking-binding",
      "targetNodeId": "TokenRewardVault",
      "getter": "staking",
      "expected": {
        "source": "deployedAddress",
        "nodeId": "TokenStaking"
      }
    },
    {
      "id": "primary-pair",
      "targetNodeId": "ProjectToken",
      "getter": "primaryPair",
      "expected": {
        "source": "factoryPair",
          "factoryInputPath": "externalAddresses.factory",
        "tokenANodeId": "ProjectToken",
          "tokenBInputPath": "externalAddresses.paymentToken"
      }
    },
    {
      "id": "oracle-pair",
      "targetNodeId": "TokenPriceOracle",
      "getter": "pair",
      "expected": {
        "source": "factoryPair",
          "factoryInputPath": "externalAddresses.factory",
        "tokenANodeId": "ProjectToken",
          "tokenBInputPath": "externalAddresses.paymentToken"
      }
    }
  ],
  "compilerSettingsPath": "COMPILER-SETTINGS.json",
  "buildCommand": "npm run build"
}
