{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "allowOutsidePaths": true,
    "assets": [
      {
        "include": "rpcs.json",
        "outDir": "../../dist/services/api"
      }
    ],
    "watchAssets": true
  }
}
